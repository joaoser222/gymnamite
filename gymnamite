#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
mode="${1:-}"

case "$mode" in
    develop)
        environment_file="develop.env"
        compose_file="compose.develop.yaml"
        profile="frontend"
        ;;
    production)
        environment_file="production.env"
        compose_file="compose.production.yaml"
        profile="worker"
        ;;
    *)
        printf 'Usage: %s {develop|production} <docker-compose-command> [arguments]\n' "$0" >&2
        exit 1
        ;;
esac

shift

exec docker compose \
    --project-directory "$project_dir" \
    --env-file "$project_dir/$environment_file" \
    -f "$project_dir/compose.yaml" \
    -f "$project_dir/$compose_file" \
    --profile "$profile" \
    "$@"
